  "contractVersion": 1,
  "siteTypes": [
    "portfolio"
  ],
  "locales": [
    "fa",
    "en"
  ],
  "proxiesApi": true,
  "capabilities": {
    "blog": true,
    "contactForm": true,
    "education": true,
    "projects": true,
    "search": true
  },
  "design": {
    "accent": "#000000",
    "background": "#ffffff",
    "foreground": "#000000",
    "lineHeight": 1.8,
    "primary": "#000000",
    "radius": "none"
  },
  "build": {
    "baseDirectory": "/",
    "buildCommand": "npm run build",
    "buildPack": "dockerfile",
    "dockerfileLocation": "Dockerfile",
    "healthCheckPath": "/api/health",
    "installCommand": "npm ci",
    "isStatic": false,
    "port": 3000,
    "startCommand": "npm run start:standalone"
  },
  "env": [
    {
      "key": "ESHOBE_CMS_URL",
      "labelFa": "نشانی سامانهٔ محتوا",
      "help": "مقدار را سکو می‌نویسد؛ پوسته فقط اعلام می‌کند که آن را می‌خواند.",
      "required": true,
      "secret": false,
      "source": "platform"
    },
    {
      "key": "ESHOBE_SITE_DOMAIN",
      "labelFa": "دامنهٔ سایت",
      "help": "برای ساخت نشانی‌های canonical و نقشهٔ سایت.",
      "required": false,
      "secret": false,
      "source": "platform"
    },
    {
      "key": "ESHOBE_PUBLIC_ORIGIN",
      "labelFa": "نشانی عمومی این استقرار",
      "help": "در حالت پیش‌نمایش با دامنهٔ اصلی تفاوت دارد.",
      "required": false,
      "secret": false,
      "source": "platform"
    },
    {
      "key": "ESHOBE_SITE_ID",
      "labelFa": "شناسهٔ سایت",
      "required": false,
      "secret": false,
      "source": "platform"
    },
    {
      "key": "ESHOBE_API_KEY",
      "labelFa": "کلید دسترسی سایت",
      "help": "فقط روی سرور خوانده می‌شود و هرگز به بستهٔ مرورگر راه نمی‌یابد.",
      "required": false,
      "secret": true,
      "source": "platform"
    },
    {
      "key": "ESHOBE_DEFAULT_LOCALE",
      "labelFa": "زبان پیش‌فرض",
      "required": false,
      "secret": false,
      "source": "platform"
    },
    {
      "key": "ESHOBE_LOCALES",
      "labelFa": "زبان‌های سروشده",
      "required": false,
      "secret": false,
      "source": "platform"
    },
    {
      "key": "ESHOBE_REVALIDATE_SECRET",
      "labelFa": "کلید بازاعتبارسنجی",
      "help": "برای بررسی HMAC روی بدنهٔ خام درخواست.",
      "required": false,
      "secret": true,
      "source": "platform"
    },
    {
      "key": "ESHOBE_PREVIEW_SECRET",
      "labelFa": "کلید پیش‌نمایش",
      "help": "تا وقتی خالی باشد، پیش‌نمایش غیرفعال است.",
      "required": false,
      "secret": true,
      "source": "platform"
    },
    {
      "key": "ESHOBE_ALLOW_HOST_TENANT",
      "labelFa": "تشخیص مستأجر از Host",
      "help": "روشن یا خاموش؛ به‌صورت پیش‌فرض هنگام وجود کلید سایت غیرفعال است.",
      "required": false,
      "secret": false,
      "source": "platform"
    }
