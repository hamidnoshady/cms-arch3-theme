{
  "name": "Architecture Portfolio (neutral placeholder)",
  "nameFa": "پوستهٔ معماری (نام موقت)",
  "key": "arch2-neutral",
  "contractVersion": 1,
  "siteTypes": [
    "portfolio"
  ],
  "locales": [
    "fa",
    "en"
  ],
  "proxiesApi": true,
  "capabilities": {
    "blog": true,
    "contactForm": true,
    "education": true,
    "projects": true,
    "search": true
  },
  "design": {
    "accent": "#000000",
    "background": "#ffffff",
    "foreground": "#000000",
    "lineHeight": 1.8,
    "primary": "#000000",
    "radius": "none"
  },
  "build": {
    "baseDirectory": "/",
    "buildCommand": "npm run build",
    "buildPack": "dockerfile",
    "dockerfileLocation": "Dockerfile",
    "healthCheckPath": "/api/health",
    "installCommand": "npm ci",
    "isStatic": false,
    "port": 3000,
    "startCommand": "npm run start:standalone"
  },
  "env": [
    {
      "key": "ESHOBE_CMS_URL",
      "labelFa": "نشانی سامانهٔ محتوا",
      "help": "مقدار را سکو می‌نویسد؛ پوسته فقط اعلام می‌کند که آن را می‌خواند.",
      "required": true,
      "secret": false,
      "source": "platform"
    },
    {
      "key": "ESHOBE_SITE_DOMAIN",
      "labelFa": "دامنهٔ سایت",
      "help": "برای ساخت نشانی‌های canonical و نقشهٔ سایت.",
      "required": false,
      "secret": false,
      "source": "platform"
    },
    {
      "key": "ESHOBE_PUBLIC_ORIGIN",
      "labelFa": "نشانی عمومی این استقرار",
      "help": "در حالت پیش‌نمایش با دامنهٔ اصلی تفاوت دارد.",
      "required": false,
      "secret": false,
      "source": "platform"
    },
    {
      "key": "ESHOBE_SITE_ID",
      "labelFa": "شناسهٔ سایت",
      "required": false,
      "secret": false,
      "source": "platform"
    },
    {
      "key": "ESHOBE_API_KEY",
      "labelFa": "کلید دسترسی سایت",
      "help": "فقط روی سرور خوانده می‌شود و هرگز به بستهٔ مرورگر راه نمی‌یابد.",
      "required": false,
      "secret": true,
      "source": "platform"
    },
    {
      "key": "ESHOBE_DEFAULT_LOCALE",
      "labelFa": "زبان پیش‌فرض",
      "required": false,
      "secret": false,
      "source": "platform"
    },
    {
      "key": "ESHOBE_LOCALES",
      "labelFa": "زبان‌های سروشده",
      "required": false,
      "secret": false,
      "source": "platform"
    },
    {
      "key": "ESHOBE_REVALIDATE_SECRET",
      "labelFa": "کلید بازاعتبارسنجی",
      "help": "برای بررسی HMAC روی بدنهٔ خام درخواست.",
      "required": false,
      "secret": true,
      "source": "platform"
    },
    {
      "key": "ESHOBE_PREVIEW_SECRET",
      "labelFa": "کلید پیش‌نمایش",
      "help": "تا وقتی خالی باشد، پیش‌نمایش غیرفعال است.",
      "required": false,
      "secret": true,
      "source": "platform"
    },
    {
      "key": "ESHOBE_ALLOW_HOST_TENANT",
      "labelFa": "تشخیص مستأجر از Host",
      "help": "روشن یا خاموش؛ به‌صورت پیش‌فرض هنگام وجود کلید سایت غیرفعال است.",
      "required": false,
      "secret": false,
      "source": "platform"
    }
  ],
  "settings": {
    "introAnimation": {
      "type": "boolean",
      "default": true,
      "labelFa": "انیمیشن ورود صفحهٔ خانه",
      "labelEn": "Home entrance animation",
      "help": "با احترام به prefers-reduced-motion؛ در حالت کاهش حرکت، حالت نهایی بی‌درنگ نمایش داده می‌شود."
    },
    "introDuration": {
      "type": "number",
      "default": 1200,
      "min": 0,
      "max": 4000,
      "labelFa": "مدت انیمیشن ورود (میلی‌ثانیه)",
      "labelEn": "Entrance duration (ms)"
    }
  },
  "contentSlots": [
    {
      "key": "home",
      "type": "page",
      "required": false,
      "labelFa": "صفحهٔ خانه",
      "labelEn": "Home page",
      "help": "نشانی خانه به‌صورت / می‌ماند؛ این اتصال تعیین می‌کند کدام سند نمایش داده شود."
    },
    {
      "key": "about",
      "type": "page",
      "required": false,
      "labelFa": "صفحهٔ درباره ما",
      "labelEn": "About page"
    },
    {
      "key": "contact",
      "type": "page",
      "required": false,
      "labelFa": "صفحهٔ تماس",
      "labelEn": "Contact page"
    },
    {
      "key": "projectsCategory",
      "type": "category",
      "required": false,
      "labelFa": "دستهٔ پروژه‌ها",
      "labelEn": "Projects category"
    },
    {
      "key": "educationCategory",
      "type": "category",
      "required": false,
      "labelFa": "دستهٔ آموزش",
      "labelEn": "Education category"
    },
    {
      "key": "blogCategory",
      "type": "category",
      "required": false,
      "labelFa": "دستهٔ یادداشت‌ها",
      "labelEn": "Notes category"
    },
    {
      "key": "contactForm",
      "type": "form",
      "required": false,
      "labelFa": "فرم تماس",
      "labelEn": "Contact form",
      "help": "فیلدها از خود فرم خوانده می‌شوند؛ پوسته فهرست فیلد نمی‌سازد."
    }
  ],
  "deployment": {
    "strategy": "registry_image",
    "registryProvider": "ghcr",
    "registryImageRepository": "ghcr.io/hamidnoshady/cms-arch3-theme",
    "registryVisibility": "public"
  }
}
